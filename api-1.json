    "/egw/payments/process/{token}": {
      "post": {
        "tags": [
          "Payment Gateway Service"
        ],
        "summary": "Process Payment",
        "description": "Process tokenized payment with expire period",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Payment Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "required": [
                  "CardNumber",
                  "Cvv",
                  "EXPMon",
                  "EXPYear"
                ],
                "type": "object",
                "properties": {
                  "CardNumber": {
                    "type": "string"
                  },
                  "Cvv": {
                    "type": "string"
                  },
                  "EXPMon": {
                    "type": "string"
                  },
                  "EXPYear": {
                    "type": "string"
                  },
                  "EvervaultSessionId": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
